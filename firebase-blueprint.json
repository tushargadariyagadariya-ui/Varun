    "User": {
      "title": "User",
      "description": "Customer or seller user profile, contact info, saved delivery addresses, and referral metadata.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["customer", "seller", "admin"] },
        "photoURL": { "type": "string", "maxLength": 500 },
        "referralCode": { "type": "string", "minLength": 4, "maxLength": 32 },
        "referredBy": { "type": "string", "maxLength": 32 },
        "rewardPoints": { "type": "number" },
        "preferredLanguage": { "type": "string", "enum": ["en", "hi"] },
        "upiId": { "type": "string", "maxLength": 100 },
        "addresses": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role", "referralCode", "rewardPoints", "createdAt", "updatedAt"]
    },
