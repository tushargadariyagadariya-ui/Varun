# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OWNER_PANEL_PASSWORD: Single backend password for accessing the TISAHARA Owner Admin Panel.
OWNER_PANEL_PASSWORD=""

# FIREBASE_SERVICE_ACCOUNT_JSON: Optional Firebase service account JSON string for tishara-4c030
# Used server-side to mint owner admin custom tokens after verifying OWNER_PANEL_PASSWORD.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# BANK_VAULT_SECRET: Optional 32+ char secret for AES-256-GCM encryption of seller bank account numbers at rest.
BANK_VAULT_SECRET=""

# PAYOUT_PROVIDER: "manual" (default), "razorpayx", or "cashfree"
# Automated transfers and provider beneficiary verification stay disabled until real credentials are configured.
PAYOUT_PROVIDER="manual"
RAZORPAYX_KEY_ID=""
RAZORPAYX_KEY_SECRET=""
RAZORPAYX_ACCOUNT_NUMBER=""
CASHFREE_PAYOUT_CLIENT_ID=""
CASHFREE_PAYOUT_CLIENT_SECRET=""
CASHFREE_PAYOUT_ENV="sandbox"
